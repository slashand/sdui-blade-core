{
  "name": "@slashand/sdui-blade-core",
  "version": "1.1.0",
  "description": "Framework-agnostic JSON-driven Blade orchestrator for Server-Driven UI architectures.",
  "author": "Slashand LLC",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "sdui",
    "server-driven-ui",
    "blade-system",
    "orchestration",
    "json-ui",
    "micro-frontends",
    "journey-protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/slashand/sdui-blade-core.git"
  },
  "bugs": {
    "url": "https://github.com/slashand/sdui-blade-core/issues"
  },
  "homepage": "https://github.com/slashand/sdui-blade-core#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/check-package.mjs",
    "dev": "tsc -w",
    "test": "vitest run",
    "publish:prod": "npm run publish:latest",
    "format": "prettier --write \"src/**/*.ts\"",
    "publish:latest": "npm run build && npm publish --access public --tag latest --provenance"
  },
  "dependencies": {
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
